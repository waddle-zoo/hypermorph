# Copy to .env and keep local-only. Nothing in this file is a real
# secret -- these are placeholder defaults that work out of the box for
# local development only. Never commit a real .env (already gitignored).

# --- Hyperset (system of record) ---
HYPERSET_DB_USER=hyperset
HYPERSET_DB_PASSWORD=hyperset-local-dev
HYPERSET_DB_NAME=hyperset
HYPERSET_DB_PORT=55432

# --- Superset metadata DB (demo profile only) ---
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset-local-dev
SUPERSET_DB_NAME=superset

# --- Analytics fixture DB: what Superset connects to and queries (demo profile only) ---
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics-local-dev
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_PORT_HOST=55434

# --- Superset bootstrap (demo profile only) ---
# Generate a real random value locally, e.g.: openssl rand -base64 42
# The placeholder below is NOT secure -- Superset will refuse to start
# with its own built-in default, so this must be set to *something*, but
# treat it as throwaway local-dev-only, never reused anywhere real.
SUPERSET_SECRET_KEY=change-me-generate-with-openssl-rand-base64-42

# The key-encryption key for an encrypted-at-rest write-back token (hy-up4k,
# ADR 0026): base64 of 32 random bytes, e.g. `openssl rand -base64 32`. If unset,
# the server uses an EPHEMERAL in-memory key with a loud warning -- fine for a
# demo (tokens do not survive a restart), never for a real deployment. Never
# committed; the env-var-name token source keeps the token out of the DB entirely.
HYPERSET_SECRET_KEY=

SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin-local-dev
SUPERSET_PORT_HOST=8088

# --- Live Superset REST sync (hyperset sync run against a base URL) ---
# Read from the environment for the life of one sync and never persisted on
# the connection. For the local demo stack these are the Superset admin
# credentials above.
HYPERSET_SUPERSET_USERNAME=admin
HYPERSET_SUPERSET_PASSWORD=admin-local-dev

# --- Pinned DataHub OSS v1.6.0 source environment (datahub profile only) ---
# Backing store credentials for DataHub's own MySQL, not Hyperset's Postgres.
DATAHUB_MYSQL_USER=datahub
DATAHUB_MYSQL_PASSWORD=datahub-local-dev
DATAHUB_GMS_PORT_HOST=8090
# GMS token auth. Off matches DataHub's own quickstart default. Turning it
# on requires HYPERSET_DATAHUB_TOKEN below; the connector treats 401/403 as
# an error, never as "the metadata is absent".
DATAHUB_METADATA_SERVICE_AUTH_ENABLED=false
# GMS and its SystemUpdate job refuse to start without a token-service
# signing key even when auth is disabled: DataHubTokenServiceFactory.validate
# throws "authentication.tokenService.signingKey must be set and not be
# empty". Local-dev throwaway values -- replace them for any non-local use,
# where they are real secrets that mint API tokens.
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=local-dev-only-signing-key-not-a-secret
DATAHUB_TOKEN_SERVICE_SALT=local-dev-only-salt-not-a-secret

# --- Live DataHub GraphQL sync (hyperset sync run against a base URL) ---
# Read from the environment for the life of one sync and never persisted on
# the connection. Leave unset while GMS auth is disabled.
# HYPERSET_DATAHUB_TOKEN=

# --- API port: the two agent-facing operations over HTTP (`api` service) ---
HYPERSET_API_PORT=8000

# --- Authorization (ADR-0030 / ADR-0035 section 5, hy-w5ld) ---
# FAIL-CLOSED on a NON-LOOPBACK bind: a server told to bind `0.0.0.0` (as the demo
# containers do, so a published port can answer) REFUSES TO START unless one of:
#   - it is published on the HOST'S LOOPBACK ONLY and asserts that topology (the demo's
#     path -- see HYPERSET_LOOPBACK_PUBLISHED below), or
#   - authorization is configured (enable the gate AND set the full OIDC verifier below).
# There is no blanket insecure override. A loopback bind stays unauthenticated by design
# (localhost is unreachable off the host). Unset by default.
# HYPERSET_AUTHZ_ENABLED=true
# HYPERSET_OIDC_ISSUER=https://your-idp.example.com/
# HYPERSET_OIDC_AUDIENCE=hyperset
# HYPERSET_OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# HYPERSET_OIDC_ROLES_CLAIM=roles
#
# Browser LOGIN (OIDC Authorization-Code + PKCE, F4 route-wiring hy-jyha). Needed only to
# serve the /login|/callback|/logout browser flow when authz is enabled; the verifier above
# still handles bearer tokens. HYPERSET_SESSION_SECRET signs the session + login cookies
# (HMAC, base64 of 32+ random bytes, e.g. `openssl rand -base64 32`); absent, no session is
# issued (fail closed). The client secret (confidential clients) is read server-side only
# and never placed in a URL, the browser, or a log; a public PKCE client omits it.
# HYPERSET_SESSION_SECRET=
# HYPERSET_OIDC_AUTHORIZATION_ENDPOINT=https://your-idp.example.com/authorize
# HYPERSET_OIDC_TOKEN_ENDPOINT=https://your-idp.example.com/token
# HYPERSET_OIDC_CLIENT_ID=hyperset-web
# HYPERSET_OIDC_REDIRECT_URI=https://your-host.example.com/callback
# HYPERSET_OIDC_CLIENT_SECRET=
# HYPERSET_OIDC_SCOPES=openid profile email
#
# HYPERSET_LOOPBACK_PUBLISHED asserts that this service's port is published on the host's
# loopback ONLY (`127.0.0.1:PORT:...`), so its in-container `0.0.0.0` bind is not
# LAN-reachable. `make up-demo` sets it in docker-compose.yml alongside a `127.0.0.1:`
# publish; a test forces that pairing. NEVER set it while publishing a port to the network
# -- that would be a false assertion and a real exposure. Not for a real network deploy.
# HYPERSET_LOOPBACK_PUBLISHED=1
# MCP needs no port: its stdio transport is spawned per client with
# `docker compose run --rm -T mcp`.
# Reserved; the review UI is not implemented yet (#39).
HYPERSET_REVIEW_UI_PORT=8080

# --- Local connector encryption key (hyperset.repositories Connection.config_encrypted) ---
# Generate locally, e.g.: openssl rand -base64 32. Never commit a real value.
HYPERSET_CONNECTOR_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# --- Git context reader file-count cap (hyperset.context.git, hy-gh-288) ---
# The maximum number of files a configured context directory may hold before a
# read fails loudly (a mis-configured path -- a repo root, a data dir -- must not
# load an arbitrary tree). Default 50; raise it for a larger-but-bounded context.
# A non-integer or non-positive value is refused, not silently ignored.
# HYPERSET_CONTEXT_MAX_FILES=50

# --- Required by the deployed OpenAI model path. Keep server-side. ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Playground model defaults (the browser never receives this key) ---
# Disabled on a normal API deployment; `make up-demo` loads the demo-only
# Docker Compose override, including its demo agents and demo defaults.
HYPERSET_PLAYGROUND_ENABLED=false
HYPERSET_MODEL_PROVIDER=openai
# `gpt-5.6-luna` is served by an OpenAI-compatible gateway and, for some accounts, by
# the vendor OpenAI endpoint too. On the vendor endpoint the playground confirms the
# model against the provider's GET /models: it is allowed if the account hosts it, and
# otherwise fails closed naming the mismatch rather than a 401 from api.openai.com. To
# force the gateway path, set HYPERSET_OPENAI_BASE_URL (below) plus OPENAI_API_KEY
# (hy-yts5j, hy-ubd6t).
HYPERSET_OPENAI_MODEL=gpt-5.6-luna
HYPERSET_OPENAI_REASONING_EFFORT=medium
# --- Embeddings (discover ranking + search). SEPARATE from the chat model above. ---
# OpenAI is the deployed default. The distinct key supports a different embedding account or
# gateway; it may hold the same value as OPENAI_API_KEY. Both remain server-side.
HYPERSET_EMBEDDING_PROVIDER=openai
HYPERSET_EMBEDDING_BASE_URL=https://api.openai.com/v1
HYPERSET_EMBEDDING_MODEL=text-embedding-3-small
# HYPERSET_EMBEDDING_API_KEY=
# The embedding width the adapter pins the space under and asks the hosted provider for.
# OpenAI's text-embedding-3-* default to 1536-d but honor a `dimensions` request; set 768 to
# preserve the shipped 768-d index contract (hy-zakwj).
HYPERSET_EMBEDDING_DIMENSIONS=768
# Optional JSON arrays configure exactly what the playground exposes in an
# enterprise deployment. There are no built-in agent profiles; the browser
# reads these from /v0/playground/status and secrets stay server-side.
# HYPERSET_PLAYGROUND_AGENTS_JSON=[{"value":"default","label":"Default","description":"A general-purpose agent for this deployment's governed context, connected sources, and read-only tools.","instruction":"Answer the user's question directly, discover and use governed context, inspect connected source metadata, use read-only tools when useful, and state uncertainty clearly."}]
# HYPERSET_PLAYGROUND_MODELS_JSON=[{"value":"gpt-5.6-luna","label":"GPT-5.6 Luna","provider":"openai"}]
# HYPERSET_PLAYGROUND_DEFAULT_AGENT=default
# HYPERSET_PLAYGROUND_DEFAULT_MODEL=gpt-5.6-luna
# HYPERSET_OPENAI_BASE_URL=https://api.openai.com/v1
